{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{server.js,*.html,*.css,*.js,*.json,*.md,docs/**,examples/**,artifacts/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
