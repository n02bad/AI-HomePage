# Copy these into your shell environment before running `npm start`.
# The UI can also send a temporary key to the local proxy, but env vars are safer.

PORT=5174

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional dev-only switch. When true, /api/home-ai/complete returns a mock
# blueprint without calling an external provider.
HOME_AI_MOCK=false

# Optional: set true only if you need to test a custom non-HTTPS provider.
ALLOW_INSECURE_AI_HTTP=false
